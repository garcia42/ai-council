[Unit]
# STAGED, NOT INSTALLED. See operations/COUNCIL_RESOLVE_DUE_TIMER.md.
Description=AI Council: grade due outcomes daily, just after each resolution day ends

[Timer]
# resolve-due grades an outcome only once its resolutionDate has ended in
# America/New_York, so run shortly after midnight there. Library checks date
# their evidence (reflog, pointer mtime, --at-field), so lateness never changes
# a verdict; it only costs grades, e.g. a release pointer rewritten by the next
# install before the check ran.
OnCalendar=*-*-* 00:40:00 America/New_York
Persistent=true
RandomizedDelaySec=5min
Unit=council-resolve-due.service

[Install]
WantedBy=timers.target
